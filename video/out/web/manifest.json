  "transcript": [
    {
      "clip": "C2-Hladanie",
      "title": "Hľadanie",
      "text": "Kedy ste naposledy nevedeli nájsť nejaký dokument? Či už správu, výkres alebo protokol? V sklade, na polici, v krabici alebo v zložke."
    },
    {
      "clip": "C4-Cena",
      "title": "Cena problému",
      "text": "Hľadanie môže trvať hodiny. Niekedy je rýchlejšie dať dokumentáciu vyhotoviť nanovo. A tak sa môže stať, že zaplatíte dvakrát za to isté. S nami ho nájdete za pár sekúnd. Predstavujeme Assetin Archives. Z vášho archívu urobíme prehľadný digitálny katalóg."
    },
    {
      "clip": "C4b-Hacik",
      "title": "C4b-Hacik",
      "text": "Naskenovať celý archív môže byť drahé. Naša aplikácia fotí len identifikačnú stranu."
    },
    {
      "clip": "C5-Teren",
      "title": "V teréne",
      "text": "Riešenie začína fyzickými dokumentami. Každá položka, či už polica, krabica, šanón alebo zložka, dostane QR kód, podľa toho, ako máte archív usporiadaný. Stačí bežný mobil."
    },
    {
      "clip": "F1-Sken",
      "title": "V mobile",
      "text": "V mobile vyberieme typ položky, ako napríklad zložka alebo dokument, a zaradíme ju do hierarchie podľa skutočnosti. Potom odfotíme jej identifikačnú stranu. Položka tým dostane svoj digitálny záznam."
    },
    {
      "clip": "F4-Kontrola",
      "title": "Kontrola",
      "text": "Návrh ale nie je finálny záznam. Človek každú hodnotu overí a potvrdí. Fotka je dôkaz a ostáva pri zázname. Prípadné opravy a doplnenia prebiehajú priamo v návrhu. Tým vznikne overený a dohľadateľný záznam fyzického dokumentu."
    },
    {
      "clip": "F3-Vyhladavanie",
      "title": "Vyhľadávanie",
      "text": "Potom stačí napísať kľúčové slovo. Aplikácia ukáže cestu k položke aj všetky vyčítané údaje. Kľúčové slovo sa zvýrazní v metadátach záznamu."
    },
    {
      "clip": "C8a-Vysledok",
      "title": "C8a-Vysledok",
      "text": "Výsledok: spoľahlivo viete, aké dokumenty máte a kde presne sa nachádzajú. Potom viete rozhodnúť, čo uchovať, skartovať alebo plnohodnotne skenovať."
    },
    {
      "clip": "C8-Pilot",
      "title": "Ako začať",
      "text": "Buď katalogizujete sami, alebo vám archív spracujeme na kľúč."
    },
    {
      "clip": "C8b-Technika",
      "title": "C8b-Technika",
      "text": "Aplikácia funguje v súlade s vašimi bezpečnostnými požiadavkami, online u nás alebo na vašej infraštruktúre."
    },
    {
      "clip": "C8c-Vyzva",
      "title": "C8c-Vyzva",
      "text": "Začnime jednou krabicou, zadarmo a nezáväzne."
    },
    {
      "clip": "C9-Outro",
      "title": "Záver",
      "text": "Assetin Archives."
    },
    {
      "clip": "C7-Hierarchia",
      "title": "C7-Hierarchia",
      "text": "Každá položka má presné miesto v hierarchii, ako napríklad polica, krabica, zložka alebo dokument."
    }
  ]
