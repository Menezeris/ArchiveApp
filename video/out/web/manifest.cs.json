  "transcript": [
    {
      "clip": "C2-Hladanie",
      "title": "Hledání",
      "text": "Kdy jste naposledy nemohli najít nějaký dokument? Ať už zprávu, výkres, nebo protokol? Ve skladu, na polici, v krabici, nebo ve složce."
    },
    {
      "clip": "C4-Cena",
      "title": "Cena problému",
      "text": "Hledání může trvat hodiny. Někdy je rychlejší nechat dokumentaci vyhotovit znovu. A tak se může stát, že zaplatíte dvakrát za totéž. S námi ho najdete za pár sekund. Představujeme Assetin Archives. Z vašeho archivu vytvoříme přehledný digitální katalog."
    },
    {
      "clip": "C4b-Hacik",
      "title": "C4b-Hacik",
      "text": "Naskenovat celý archiv může být drahé. Naše aplikace fotí jen identifikační stranu."
    },
    {
      "clip": "C5-Teren",
      "title": "V terénu",
      "text": "Řešení začíná u fyzických dokumentů. Každá položka, ať už police, krabice, šanon, nebo složka, dostane QR kód, podle toho, jak máte archiv uspořádaný. Stačí běžný mobil."
    },
    {
      "clip": "F1-Sken",
      "title": "V mobilu",
      "text": "V mobilu vybereme typ položky, například složku nebo dokument, a zařadíme ji do hierarchie podle skutečnosti. Pak vyfotíme její identifikační stranu. Položka tím získá svůj digitální záznam."
    },
    {
      "clip": "F4-Kontrola",
      "title": "Kontrola",
      "text": "Návrh ale není konečný záznam. Člověk každou hodnotu ověří a potvrdí. Fotka je důkaz a zůstává u záznamu. Případné opravy a doplnění probíhají přímo v návrhu. Tím vznikne ověřený a dohledatelný záznam fyzického dokumentu."
    },
    {
      "clip": "F3-Vyhladavanie",
      "title": "Vyhledávání",
      "text": "Pak stačí napsat klíčové slovo. Aplikace ukáže cestu k položce i všechny vyčtené údaje. Klíčové slovo se zvýrazní v metadatech záznamu."
    },
    {
      "clip": "C8a-Vysledok",
      "title": "C8a-Vysledok",
      "text": "Výsledek: spolehlivě víte, jaké dokumenty máte a kde přesně se nacházejí. Pak se můžete rozhodnout, co uchovat, co skartovat a co plně naskenovat."
    },
    {
      "clip": "C8-Pilot",
      "title": "Jak začít",
      "text": "Buď katalogizujete sami, nebo vám archiv zpracujeme na klíč."
    },
    {
      "clip": "C8b-Technika",
      "title": "C8b-Technika",
      "text": "Aplikace funguje v souladu s vašimi bezpečnostními požadavky, online u nás nebo na vaší infrastruktuře."
    },
    {
      "clip": "C8c-Vyzva",
      "title": "C8c-Vyzva",
      "text": "Začněme jednou krabicí, zdarma a nezávazně."
    },
    {
      "clip": "C9-Outro",
      "title": "Závěr",
      "text": "Assetin Archives."
    },
    {
      "clip": "C7-Hierarchia",
      "title": "C7-Hierarchia",
      "text": "Každá položka má přesné místo v hierarchii, například police, krabice, složka nebo dokument."
    }
  ]
}
